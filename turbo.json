{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.spec.ts"]
    },
    "@repo/database#build": {
      "dependsOn": ["db:generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "seed:kols": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "create-vault": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "sync-tokens": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "seed-vaults": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "sync-aliases": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "seed-stocks": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "backfill-algo-all": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "sync-icons": {
      "cache": false,
      "dependsOn": ["^db:generate"]
    },
    "initialize-factory": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "create-vault-onchain": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:vault:memo": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:vault:transfer": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "test:vault:swap": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "program:deploy": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "EXPO_PUBLIC_PRIVY_APP_ID",
    "EXPO_PUBLIC_PRIVY_CLIENT_ID",
    "PRIVY_APP_SECRET",
    "RAPIDAPI_KEY",
    "RAPIDAPI_HOST",
    "FETCH_DELAY_MS",
    "ANTHROPIC_API_KEY",
    "SOLANA_RPC_URL",
    "EXPO_PUBLIC_SOLANA_RPC_URL",
    "KEEPER_PRIVATE_KEY",
    "PROGRAM_AUTHORITY_PRIVATE_KEY",
    "PRICE_INSTANCE_ID",
    "PRICE_TOTAL_INSTANCES",
    "JUPITER_API_KEY",
    "REBALANCE_DRY_RUN",
    "MAX_PRICE_IMPACT_BPS",
    "MIN_SWAP_USD",
    "MAX_SWAP_EQUITY_PCT",
    "SNAPSHOT_STALENESS_H",
    "CRON_FETCH_TWEETS",
    "CRON_RUN_ALGO",
    "CRON_REBALANCE_VAULTS",
    "BIRDEYE_API_KEY",
    "NEXT_PUBLIC_API_URL",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "CRON_HEALTH_CHECK",
    "CRON_SYNC_PROFILES",
    "CRON_FETCH_PRICES",
    "NEXT_PUBLIC_MAKE_WEBHOOK_URL",
    "REDIS_URL",
    "WITHDRAWAL_BATCH_WINDOW_MS",
    "WITHDRAWAL_MAX_RETRIES",
    "CRON_RECOVERY_WITHDRAWALS",
    "FEE_PAYER_PRIVATE_KEY",
    "FUND_SOL_FEE_PCT",
    "CRON_SNAPSHOT_PORTFOLIOS"
  ],
  "globalPassThroughEnv": ["CI"]
}

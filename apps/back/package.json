{
  "name": "@repo/back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc && cp -r src/data dist/",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "seed:kols": "tsx src/scripts/seed-kols.ts",
    "create-vault": "tsx src/scripts/create-kol-vault.ts",
    "sync-tokens": "tsx src/scripts/sync-jupiter-tokens.ts",
    "seed-vaults": "tsx src/scripts/seed-vaults.ts",
    "sync-aliases": "tsx --env-file=../../.env src/scripts/sync-asset-aliases.ts",
    "seed-stocks": "tsx --env-file=../../.env src/scripts/seed-stock-tokens.ts",
    "backfill-algo-all": "tsx --env-file=../../.env src/scripts/backfill-and-run-algo-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@coral-xyz/anchor": "^0.30.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.2.0",
    "@glamsystems/glam-sdk": "^1.0.11",
    "@glamsystems/ix-mapper": "^0.1.0",
    "@privy-io/server-auth": "^1.32.5",
    "@repo/database": "workspace:*",
    "@repo/shared": "workspace:*",
    "@repo/solana": "workspace:*",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "axios": "^1.13.2",
    "bn.js": "^5.2.1",
    "bs58": "5",
    "bullmq": "^5.70.1",
    "fastify": "^5.1.0",
    "grammy": "^1.35.0",
    "ioredis": "^5.10.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

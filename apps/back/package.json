    "axios": "^1.13.2",
    "bs58": "5",
    "bullmq": "^5.70.1",
    "fastify": "^5.1.0",
    "grammy": "^1.35.0",
    "ioredis": "^5.10.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^3.24.0"

# Backend API URL (use your machine's local IP for Android device/emulator access)
# Find your IP with: ipconfig getifaddr en0 (macOS) or hostname -I (Linux)
# iOS simulator can use localhost, but Android cannot
EXPO_PUBLIC_API_URL=http://192.168.1.XXX:4001

# Privy authentication (get from https://dashboard.privy.io)
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id

# Solana RPC & network
EXPO_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_api_key
# Set to "devnet" to use devnet USDC mint automatically
# EXPO_PUBLIC_SOLANA_NETWORK=devnet
# Or override USDC mint directly:
# EXPO_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

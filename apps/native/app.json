{
  "expo": {
    "name": "Autopilot",
    "slug": "omaha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "autopilot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autopilot.native"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090B"
      },
      "package": "com.autopilot.native"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privyAppId": "cmh2jz1dz048ql70c7d0grhbe",
      "privyClientId": "client-WY6SHSQy7tPdZFv2ajMaZhAj6jSTbo4HSBjVuo6WXuhLj",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2b940c70-f68b-4c4d-83f8-dd1286547c9c"
      }
    },
    "owner": "omahaboyz"
  }
}

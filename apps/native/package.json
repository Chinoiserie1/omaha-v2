{
  "name": "@repo/native",
  "version": "0.0.0",
  "private": true,
  "main": "entrypoint.js",
  "scripts": {
    "start": "expo start",
    "dev": "npx expo prebuild --clean && expo run:ios",
    "build": "npx expo prebuild",
    "android": "expo run:android",
    "android:release": "expo prebuild --clean && expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo prebuild --clean && expo run:ios --configuration Release",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo ios android",
    "eas:ios:build": "eas build -p ios --profile production",
    "eas:ios:submit": "eas submit -p ios --profile production",
    "eas:android:build": "eas build -p android --profile production",
    "eas:android:build:preview": "eas build -p android --profile preview",
    "eas:android:submit": "eas submit -p android --profile production",
    "eas-build-post-install": "cd ../.. && pnpm --filter @repo/shared build && pnpm --filter @repo/solana build"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@ethersproject/shims": "^5.8.0",
    "@expo/vector-icons": "^14.0.4",
    "@privy-io/expo": "^0.63.0",
    "@privy-io/expo-native-extensions": "^0.0.6",
    "@repo/shared": "workspace:*",
    "@repo/solana": "workspace:*",
    "@shopify/flash-list": "^1.7.3",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.90.21",
    "buffer": "^6.0.3",
    "expo": "~52.0.49",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-asset": "~11.0.5",
    "expo-clipboard": "^7.0.1",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "^13.0.4",
    "expo-haptics": "^14.0.1",
    "expo-image": "^2.0.7",
    "expo-linking": "~7.0.5",
    "expo-localization": "~16.0.1",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "^4.0.9",
    "expo-web-browser": "~14.0.2",
    "fast-text-encoding": "^1.0.6",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.36.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "^2.20.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-passkeys": "^0.4.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-wagmi-charts": "^2.9.1",
    "react-native-webview": "^13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/react": "~18.3.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}

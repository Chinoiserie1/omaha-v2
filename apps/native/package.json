{
  "name": "@repo/native",
  "version": "0.0.0",
  "private": true,
  "main": "entrypoint.js",
  "scripts": {
    "start": "expo start",
    "dev": "npx expo prebuild --clean && expo run:ios",
    "build": "npx expo prebuild",
    "android": "expo run:android",
    "android:release": "expo prebuild --clean && expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo prebuild --clean && expo run:ios --configuration Release",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo ios android",
    "eas:ios:build": "eas build -p ios --profile production",
    "eas:ios:submit": "eas submit -p ios --profile production",
    "eas:android:build": "eas build -p android --profile production",
    "eas:android:submit": "eas submit -p android --profile production",
    "eas-build-post-install": "cd ../.. && pnpm db:generate && pnpm build"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@ethersproject/shims": "^5.8.0",
    "@expo/vector-icons": "^15.0.3",
    "@privy-io/expo": "^0.63.0",
    "@privy-io/expo-native-extensions": "^0.0.6",
    "@repo/shared": "workspace:*",
    "@shopify/flash-list": "^2.2.2",
    "@solana/web3.js": "^1.98.4",
    "buffer": "^6.0.3",
    "expo": "~52.0.0",
    "expo-apple-authentication": "~7.1.3",
    "expo-application": "~6.0.2",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "fast-text-encoding": "^1.0.6",
    "nativewind": "^4.2.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-get-random-values": "^2.0.0",
    "react-native-passkeys": "^0.4.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "4.14.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/react": "~18.3.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}

{
  "name": "autopilot",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:back": "pnpm --filter @repo/back dev",
    "dev:ios": "pnpm --filter @repo/native dev",
    "dev:ios:release": "pnpm --filter @repo/native ios:release",
    "dev:android": "pnpm --filter @repo/native android",
    "dev:android:release": "pnpm --filter @repo/native android:release",
    "build": "turbo run build",
    "build:web": "pnpm --filter @repo/web build",
    "build:back": "pnpm --filter @repo/back build",
    "lint": "turbo run lint",
    "lint:web": "pnpm --filter @repo/web lint",
    "lint:back": "pnpm --filter @repo/back lint",
    "lint:native": "pnpm --filter @repo/native lint",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "pnpm --filter @repo/web typecheck",
    "typecheck:back": "pnpm --filter @repo/back typecheck",
    "typecheck:native": "pnpm --filter @repo/native typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "seed:kols": "turbo run seed:kols",
    "create-vault": "turbo run create-vault",
    "sync-tokens": "turbo run sync-tokens",
    "sync-aliases": "turbo run sync-aliases",
    "seed-stocks": "turbo run seed-stocks",
    "seed-vaults": "turbo run seed-vaults",
    "backfill-algo-all": "turbo run backfill-algo-all",
    "sync-icons": "turbo run sync-icons",
    "initialize-factory": "turbo run initialize-factory",
    "create-vault-onchain": "turbo run create-vault-onchain",
    "test:vault:memo": "turbo run test:vault:memo",
    "test:vault:transfer": "turbo run test:vault:transfer",
    "test:vault:swap": "turbo run test:vault:swap",
    "start:back": "pnpm --filter @repo/back start",
    "native:clean": "pnpm --filter @repo/native clean",
    "wt:ios": "bash scripts/worktree-dev.sh ios",
    "wt:android": "bash scripts/worktree-dev.sh android",
    "wt:start": "bash scripts/worktree-dev.sh",
    "wt:create": "bash scripts/worktree-create.sh",
    "wt:clean": "bash scripts/worktree-clean.sh",
    "program:build": "cargo build-sbf --manifest-path apps/programs/vault/Cargo.toml --features bpf-entrypoint",
    "program:test": "SBF_OUT_DIR=$PWD/target/deploy cargo test --manifest-path apps/programs/vault/Cargo.toml",
    "program:deploy": "solana program deploy target/deploy/omaha_vault.so --program-id target/deploy/omaha_vault-keypair.json --url devnet",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.7.1",
    "typescript": "^5.7.2"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "react-native-css-interop": "0.2.2"
    },
    "patchedDependencies": {
      "posthog-react-native-session-replay@1.4.0": "patches/posthog-react-native-session-replay@1.4.0.patch",
      "react-native-css-interop@0.2.2": "patches/react-native-css-interop@0.2.2.patch"
    }
  }
}

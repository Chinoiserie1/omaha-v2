# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://user:password@localhost:5456/autopilot"

# Environment
NODE_ENV=development

# Privy (React Native app)
# Get these from https://dashboard.privy.io
EXPO_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
EXPO_PUBLIC_PRIVY_CLIENT_ID="your-privy-client-id"
PRIVY_APP_SECRET="your-privy-app-secret"

# PostHog (Analytics & Error Tracking - EU Cloud)
# Get your API key from https://eu.posthog.com/settings/project
EXPO_PUBLIC_POSTHOG_API_KEY="your-posthog-api-key"

# Backend API URL (for native app)
EXPO_PUBLIC_API_URL="http://localhost:4001"

# ── KOL Pipeline ──────────────────────────────────────────────

# Twitter (RapidAPI)
RAPIDAPI_KEY=
RAPIDAPI_HOST=twitter241.p.rapidapi.com
FETCH_DELAY_MS=1500

# AI (Anthropic)
ANTHROPIC_API_KEY=

# Solana (optional — crons work without these)
SOLANA_RPC_URL=
EXPO_PUBLIC_SOLANA_RPC_URL=
KEEPER_PRIVATE_KEY=
GLAM_PROGRAM_ID=GLAMpaME8wdTEzxtiYEAa5yD8fZbxZiz2hNtV58RZiEz

# Jupiter
JUPITER_API_KEY=

# Birdeye (price data for backtesting)
BIRDEYE_API_KEY=

# Rebalancing
REBALANCE_DRY_RUN=true
MAX_PRICE_IMPACT_BPS=100
MIN_SWAP_USD=5
MAX_SWAP_EQUITY_PCT=25
SNAPSHOT_STALENESS_H=24

# Cron Schedules
CRON_FETCH_TWEETS="*/15 * * * *"
CRON_RUN_ALGO="*/30 * * * *"
CRON_REBALANCE_VAULTS="0 */6 * * *"
# Profile sync
CRON_SYNC_PROFILES="0 3 * * 0"
# Token prices
CRON_FETCH_PRICES="* * * * *"
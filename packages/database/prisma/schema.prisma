generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  REAL
  PLACEHOLDER
}

model User {
  id                    String              @id @default(cuid())
  privyId               String?             @unique
  email                 String?             @unique
  username              String?             @unique
  name                  String?
  walletAddress         String?             @unique
  twitterId             String?             @unique
  twitterUsername        String?
  twitterFollowerCount  Int?
  profileImageUrl       String?
  bio                   String?
  hasTwitter            Boolean             @default(false)
  userType              UserType            @default(REAL)
  onboardingCompleted   Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  followers             Follow[]            @relation("Following")
  following             Follow[]            @relation("Followers")
  withdrawalRequests    WithdrawalRequest[]
  vaultFavorites        VaultFavorite[]
  quant                 Quant?
  chatMessages          ChatMessage[]
  pushTokens            PushToken[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ── Quant Pipeline Models ─────────────────────────────────────────

model Quant {
  id             String              @id @default(cuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive       Boolean             @default(true)
  algoEnabled    Boolean             @default(true)
  knowledge      Json?
  lastFetchedAt  DateTime?
  tweets         Tweet[]
  portfolios     PortfolioSnapshot[]
  vault          Vault?
  tweetImpacts   TweetImpact[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Tweet {
  id             String           @id @default(cuid())
  tweetId        String           @unique
  quantId        String
  quant          Quant            @relation(fields: [quantId], references: [id], onDelete: Cascade)
  fullText       String
  postedAt       DateTime
  favoriteCount  Int              @default(0)
  retweetCount   Int              @default(0)
  replyCount     Int              @default(0)
  bookmarkCount  Int              @default(0)
  viewsCount     Int              @default(0)
  isRetweet      Boolean          @default(false)
  isReply        Boolean          @default(false)
  isThread       Boolean          @default(false)
  conversationId String?
  rawJson        Json?
  source         String           @default("twitter")
  sourceUrl      String?
  classification ClassifiedTweet?
  impacts        TweetImpact[]
  createdAt      DateTime         @default(now())
  fetchedAt      DateTime         @default(now())

  @@index([quantId, postedAt])
  @@index([quantId, tweetId])
  @@index([conversationId])
}

model ClassifiedTweet {
  id             String   @id @default(cuid())
  tweetId        String   @unique
  tweet          Tweet    @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  category       String
  assets         String[]
  sentiment      String?
  conviction     String?
  rawLlmResponse Json?
  classifiedAt   DateTime @default(now())

  @@index([tweetId])
}

model PortfolioSnapshot {
  id              String           @id @default(cuid())
  quantId         String
  quant           Quant            @relation(fields: [quantId], references: [id], onDelete: Cascade)
  thesisSummary   String
  allocations     Json
  changes         String[]
  sourceTweetIds  String[]
  createdAt       DateTime         @default(now())
  rebalanceEvents RebalanceEvent[]
  tweetImpacts    TweetImpact[]

  // Backtest: this snapshot is the "from" side of a performance period
  perfFrom SnapshotPerformance[] @relation("PerfFrom")
  // Backtest: this snapshot is the "to" side of a performance period
  perfTo   SnapshotPerformance[] @relation("PerfTo")

  @@index([quantId, createdAt])
}

model TweetImpact {
  id                String            @id @default(cuid())
  tweetId           String
  tweet             Tweet             @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  quantId           String
  quant             Quant             @relation(fields: [quantId], references: [id], onDelete: Cascade)
  snapshotId        String
  snapshot          PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  assets            String[]
  impactType        String
  allocationDelta   Float
  conviction        String
  sentiment         String
  category          String
  engagementScore   Float
  significanceScore Float
  createdAt         DateTime          @default(now())

  @@unique([tweetId, snapshotId])
  @@index([quantId, significanceScore])
  @@index([quantId, createdAt])
  @@index([snapshotId])
}

model Vault {
  id                 String              @id @default(cuid())
  quantId            String              @unique
  quant              Quant               @relation(fields: [quantId], references: [id], onDelete: Cascade)
  statePda           String              @unique
  shareMint          String?             @unique
  baseTokenAta       String?
  mintAddress        String?             @unique
  vaultName          String
  vaultSymbol        String
  dryRun             Boolean             @default(true)
  isActive           Boolean             @default(true)
  about              String              @default("")
  dataSource         String              @default("")
  performanceCalc    String              @default("")
  disclosure         String              @default("")
  lastRebalancedAt   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rebalanceEvents    RebalanceEvent[]
  holdingsSnapshots  HoldingsSnapshot[]
  withdrawalRequests WithdrawalRequest[]
  favorites          VaultFavorite[]

  @@index([quantId])
}

model RebalanceEvent {
  id             String            @id @default(cuid())
  vaultId        String
  vault          Vault             @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  snapshotId     String
  snapshot       PortfolioSnapshot @relation(fields: [snapshotId], references: [id])
  status         String
  sellCount      Int               @default(0)
  buyCount       Int               @default(0)
  totalSwaps     Int               @default(0)
  swapDetails    Json?
  vaultEquityUsd Float?
  errorMessage   String?
  startedAt      DateTime          @default(now())
  completedAt    DateTime?

  @@index([vaultId, startedAt])
  @@index([snapshotId])
}

model HoldingsSnapshot {
  id             String    @id @default(cuid())
  vaultId        String
  vault          Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  holdings       Json
  totalEquityUsd Float
  startDate      DateTime  @default(now())
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  @@index([vaultId, startDate])
  @@index([vaultId, endDate])
}

// ── Backtest Models ───────────────────────────────────────────

model TokenPriceDaily {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime @db.Date
  priceUsd  Float
  source    String
  fetchedAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date])
}

model SnapshotPerformance {
  id              String            @id @default(cuid())
  quantId         String
  fromSnapshotId  String
  fromSnapshot    PortfolioSnapshot @relation("PerfFrom", fields: [fromSnapshotId], references: [id], onDelete: Cascade)
  toSnapshotId    String
  toSnapshot      PortfolioSnapshot @relation("PerfTo", fields: [toSnapshotId], references: [id], onDelete: Cascade)
  periodReturn    Float
  cumulativeValue Float
  periodDays      Int
  details         Json?
  computedAt      DateTime          @default(now())

  @@unique([fromSnapshotId, toSnapshotId])
  @@index([quantId, computedAt])
}

// ── Token Price Models ────────────────────────────────────────

model Token {
  id        String       @id @default(cuid())
  name      String
  symbol    String       @unique
  decimals  Int
  mint      String       @unique
  logoUri   String?
  isVault   Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  prices    TokenPrice[]
}

model TokenPrice {
  id       String   @id @default(cuid())
  tokenId  String
  token    Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  usdPrice Float
  date     DateTime @default(now())

  @@index([tokenId, date])
}

// ── Portfolio Value Snapshots ─────────────────────────────────────

model PortfolioValueSnapshot {
  id            String   @id @default(cuid())
  walletAddress String
  totalValueUsd Float
  holdings      Json // [{ mint, symbol, amount, usdPrice, valueUsd }]
  snapshotDate  DateTime @default(now())

  @@index([walletAddress, snapshotDate])
}

// ── Withdrawal Queue Models ─────────────────────────────────────
model WithdrawalRequest {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultId           String
  vault             Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  amount            Float
  status            String    @default("REQUESTED")
  idempotencyKey    String    @unique
  batchId           String
  redeemTxSignature String?
  claimTxSignature  String?
  errorMessage      String?
  errorCount        Int       @default(0)
  removedReason     String?
  requestedAt       DateTime  @default(now())
  processingAt      DateTime?
  claimableAt       DateTime?
  claimedAt         DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([vaultId, status])
  @@index([batchId])
  @@index([status, requestedAt])
  @@index([status, processingAt])
}

// ── Chat Messages ───────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Push Tokens ─────────────────────────────────────────────

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Vault Favorites ─────────────────────────────────────────

model VaultFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultId   String
  vault     Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vaultId])
  @@index([userId])
  @@index([vaultId])
}

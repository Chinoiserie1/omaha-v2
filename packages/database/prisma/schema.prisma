generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  privyId             String   @unique
  email               String?  @unique
  username            String?  @unique
  name                String?
  twitterId           String?  @unique
  twitterUsername     String?
  profileImageUrl     String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  followers           Follow[] @relation("Following")
  following           Follow[] @relation("Followers")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ── KOL Pipeline Models ─────────────────────────────────────────

model Kol {
  id             String              @id @default(cuid())
  username       String              @unique
  displayName    String?
  restId         String?             @unique
  followersCount Int?
  avatarUrl      String?
  bio            String?
  hasTwitter     Boolean             @default(true)
  isActive       Boolean             @default(true)
  algoEnabled    Boolean             @default(true)
  lastFetchedAt  DateTime?
  tweets         Tweet[]
  portfolios     PortfolioSnapshot[]
  vault          KolVault?
  tweetImpacts   TweetImpact[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Tweet {
  id             String           @id @default(cuid())
  tweetId        String           @unique
  kolId          String
  kol            Kol              @relation(fields: [kolId], references: [id], onDelete: Cascade)
  fullText       String
  postedAt       DateTime
  favoriteCount  Int              @default(0)
  retweetCount   Int              @default(0)
  replyCount     Int              @default(0)
  bookmarkCount  Int              @default(0)
  viewsCount     Int              @default(0)
  isRetweet      Boolean          @default(false)
  isReply        Boolean          @default(false)
  isThread       Boolean          @default(false)
  conversationId String?
  rawJson        Json?
  source         String           @default("twitter")
  sourceUrl      String?
  classification ClassifiedTweet?
  impacts        TweetImpact[]
  createdAt      DateTime         @default(now())
  fetchedAt      DateTime         @default(now())

  @@index([kolId, postedAt])
  @@index([kolId, tweetId])
  @@index([conversationId])
}

model ClassifiedTweet {
  id             String   @id @default(cuid())
  tweetId        String   @unique
  tweet          Tweet    @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  category       String
  assets         String[]
  sentiment      String?
  conviction     String?
  rawLlmResponse Json?
  classifiedAt   DateTime @default(now())

  @@index([tweetId])
}

model PortfolioSnapshot {
  id              String           @id @default(cuid())
  kolId           String
  kol             Kol              @relation(fields: [kolId], references: [id], onDelete: Cascade)
  thesisSummary   String
  allocations     Json
  changes         String[]
  sourceTweetIds  String[]
  createdAt       DateTime         @default(now())
  rebalanceEvents RebalanceEvent[]
  tweetImpacts    TweetImpact[]

  // Backtest: this snapshot is the "from" side of a performance period
  perfFrom SnapshotPerformance[] @relation("PerfFrom")
  // Backtest: this snapshot is the "to" side of a performance period
  perfTo   SnapshotPerformance[] @relation("PerfTo")

  @@index([kolId, createdAt])
}

model TweetImpact {
  id                String            @id @default(cuid())
  tweetId           String
  tweet             Tweet             @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  kolId             String
  kol               Kol               @relation(fields: [kolId], references: [id], onDelete: Cascade)
  snapshotId        String
  snapshot          PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  assets            String[]
  impactType        String
  allocationDelta   Float
  conviction        String
  sentiment         String
  category          String
  engagementScore   Float
  significanceScore Float
  createdAt         DateTime          @default(now())

  @@unique([tweetId, snapshotId])
  @@index([kolId, significanceScore])
  @@index([kolId, createdAt])
  @@index([snapshotId])
}

model KolVault {
  id               String           @id @default(cuid())
  kolId            String           @unique
  kol              Kol              @relation(fields: [kolId], references: [id], onDelete: Cascade)
  kolUsername      String           @default("")
  avatarUrl        String           @default("")
  name             String           @default("")
  description      String           @default("")
  glamVaultPda     String?          @unique
  statePda         String           @unique
  mintAddress      String?          @unique
  vaultName        String
  vaultSymbol      String
  dryRun           Boolean          @default(true)
  isActive         Boolean          @default(true)
  jupiterEnabled   Boolean          @default(false)
  about            String           @default("")
  dataSource       String           @default("")
  performanceCalc  String           @default("")
  disclosure       String           @default("")
  lastRebalancedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  rebalanceEvents    RebalanceEvent[]
  holdingsSnapshots  HoldingsSnapshot[]

  @@index([kolId])
}

model RebalanceEvent {
  id             String            @id @default(cuid())
  kolVaultId     String
  kolVault       KolVault          @relation(fields: [kolVaultId], references: [id], onDelete: Cascade)
  snapshotId     String
  snapshot       PortfolioSnapshot @relation(fields: [snapshotId], references: [id])
  status         String
  sellCount      Int               @default(0)
  buyCount       Int               @default(0)
  totalSwaps     Int               @default(0)
  swapDetails    Json?
  vaultEquityUsd Float?
  errorMessage   String?
  startedAt      DateTime          @default(now())
  completedAt    DateTime?

  @@index([kolVaultId, startedAt])
  @@index([snapshotId])
}

model HoldingsSnapshot {
  id             String    @id @default(cuid())
  kolVaultId     String
  kolVault       KolVault  @relation(fields: [kolVaultId], references: [id], onDelete: Cascade)
  holdings       Json
  totalEquityUsd Float
  startDate      DateTime  @default(now())
  endDate        DateTime?
  createdAt      DateTime  @default(now())

  @@index([kolVaultId, startDate])
  @@index([kolVaultId, endDate])
}

model TradeableAsset {
  id       String  @id @default(cuid())
  symbol   String  @unique
  name     String
  mint     String
  decimals Int
  isActive Boolean @default(true)
}

// ── Backtest Models ───────────────────────────────────────────

model TokenPriceDaily {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime @db.Date
  priceUsd  Float
  source    String
  fetchedAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date])
}

model SnapshotPerformance {
  id              String            @id @default(cuid())
  kolId           String
  fromSnapshotId  String
  fromSnapshot    PortfolioSnapshot @relation("PerfFrom", fields: [fromSnapshotId], references: [id], onDelete: Cascade)
  toSnapshotId    String
  toSnapshot      PortfolioSnapshot @relation("PerfTo", fields: [toSnapshotId], references: [id], onDelete: Cascade)
  periodReturn    Float
  cumulativeValue Float
  periodDays      Int
  details         Json?
  computedAt      DateTime          @default(now())

  @@unique([fromSnapshotId, toSnapshotId])
  @@index([kolId, computedAt])
}

// ── Token Price Models ────────────────────────────────────────

model Token {
  id        String       @id @default(cuid())
  name      String
  symbol    String
  decimals  Int
  mint      String       @unique
  isVault   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  prices    TokenPrice[]

  @@index([symbol])
}

model TokenPrice {
  id       String   @id @default(cuid())
  tokenId  String
  token    Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  usdPrice Float
  date     DateTime @default(now())

  @@index([tokenId, date])
}
